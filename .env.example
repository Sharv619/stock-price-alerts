# Kite Connect (Zerodha)
KITE_API_KEY=your_api_key_from_developers.kite.trade
KITE_API_SECRET=your_api_secret_from_developers.kite.trade

# Whapi (WhatsApp)
WHAPI_TOKEN=your_whapi_channel_token_here
WHAPI_URL=https://gate.whapi.cloud/

# Gmail
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App config
CHECK_INTERVAL_SECONDS=60
# Re-notify at most once per this many minutes while condition holds
NOTIFY_COOLDOWN_MINUTES=60
# myaccount.google.com/apppasswords

# Optional — frontend uses this to find the backend (default http://localhost:8600)
# API_URL=http://localhost:8600
